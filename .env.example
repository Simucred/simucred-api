DB_HOST=postgres
DB_PORT=5432
DB_NAME=simucred
DB_USER=postgres
DB_PASSWORD=postgrespassword

KEY_USER=admin
KEY_PASSWORD=admin
KEY_PORT=8081

API_PORT=8080
# Front-end (serviço web): o profile "full" sobe o front junto.
# Requer o repositório simucred_web clonado ao lado deste.
# Remova esta linha para subir só banco, Keycloak e API.
COMPOSE_PROFILES=full
WEB_PORT=4200
WEB_PATH=../simucred_web/simucred
